@@ -854,6 +877,15 @@ sweet_surface_layout(SweetSurface *s, OSDictionary *props)
 		s->planeCount = planes->getCount();
 	}
 
+	if (sweet_surface_bgra_only() &&
+	    (s->pixelFormat != 0x42475241u || s->planeCount > 1 ||
+	     s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1)) {
+		IOLog("SWEET SURF: ath12k combo: refuse non-BGRA layout fmt 0x%x planes %u bpe %u ew %u eh %u (BGRA 8bpc only)\n",
+		    s->pixelFormat, s->planeCount, s->bytesPerElement,
+		    s->elementWidth, s->elementHeight);
+		return kIOReturnBadArgument;
+	}
+
 	uint64_t alloc = sweet_dict_u32(props, "IOSurfaceAllocSize", 0);
 	if (alloc < end) {
 		alloc = end;
