+		printf("FUXI ATH12K: PCIe enum: no WCN7850 (expected vendor %#x device %#x class %#x; "
+		    "actual vendor %#x device %#x class %#x header %#x); fall back to containment\n",
+		    WLA_PCI_VENDOR, WLA_PCI_DEVICE, 0x280u,
+		    vendor, device, class_code, htype);
