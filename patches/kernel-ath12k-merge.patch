+	uint32_t orig_hi = wl_prd(WL_EPCFG + 0x14);
+	wl_pwr(WL_EPCFG + 0x04, cmd & 0xffffu & ~7u);
+	wl_pwr(WL_EPCFG + 0x10, 0xffffffffu);
+	wl_pwr(WL_EPCFG + 0x14, 0xffffffffu);
+	uint32_t size_lo = wl_prd(WL_EPCFG + 0x10);
+	uint32_t size_hi = wl_prd(WL_EPCFG + 0x14);
+	wl_pwr(WL_EPCFG + 0x10, orig_lo);
+	wl_pwr(WL_EPCFG + 0x14, orig_hi);
+	printf("FUXI ATH12K: BAR0 orig %#x/%#x sizing %#x/%#x\n",
+	    orig_lo, orig_hi, size_lo, size_hi);
