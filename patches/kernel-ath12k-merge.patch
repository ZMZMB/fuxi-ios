+ * Channel order assumes B10G10R10; if the field is actually R/B swapped the only
+ * symptom would be red/blue exchanged, not a black panel. */
+static uint32_t
+fuxi_fb_bgra10_unpack(uint32_t word, uint8_t alpha)
+{
+	uint8_t b = (uint8_t)((word & 0x3FFu) >> 2);
+	uint8_t g = (uint8_t)(((word >> 10) & 0x3FFu) >> 2);
+	uint8_t r = (uint8_t)(((word >> 20) & 0x3FFu) >> 2);
+	return (uint32_t)b | ((uint32_t)g << 8) | ((uint32_t)r << 16) | ((uint32_t)alpha << 24);
