+/*
+ * ath12k WLAN combination: fuxiwlan=1 and fuxiwlanath=1 (the boot that also
+ * links fuxi_ath12k.o). On this chain the GPU scanout and its CPU oracle only
+ * carry an 8-bit BGRA single-plane layout; a 10-bit / two-plane or packed mask
+ * surface cannot be presented raw. The surface is accepted at the kernel
+ * boundary and decompressed to BGRA8 on the CPU present path (see the convert
+ * branch in SweetFramebuffer::present). Without both args the pre-existing
+ * acceptance is kept: single fuxiwlan, single fuxiath, and the default control
+ * boot are unchanged.
+ */
+#define SWEET_FMT_BGRA8   0x42475241u  /* 'BGRA' */
+#define SWEET_FMT_B3A8    0x62336138u  /* 'b3a8' 30RGBLE_8A_BiPlanar */
+#define SWEET_FMT_LA08    0x4c413038u  /* 'LA08' packed L/A mask, bpe2 */
+
+static int
+sweet_surface_combo_active(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		int wlan = 0, ath = 0;
+		unsigned wlan_on = PE_parse_boot_argn("fuxiwlan", &wlan, sizeof(wlan)) && wlan > 0;
+		unsigned ath_on = PE_parse_boot_argn("fuxiwlanath", &ath, sizeof(ath)) && ath == 1;
+		cached = (wlan_on && ath_on) ? 1 : 0;
+	}
+	return cached;
+}
+
+/* Convert kind for the present path; 0 = plain BGRA8 / outside the combo. */
+int
+sweet_surface_convert_kind(SweetSurface *s)
+{
+	if (!s || !sweet_surface_combo_active()) return 0;
+	if (s->pixelFormat == SWEET_FMT_BGRA8 && s->planeCount <= 1 &&
+	    s->bytesPerElement == 4 && s->elementWidth == 1 && s->elementHeight == 1)
+		return 0;
+	if (s->pixelFormat == SWEET_FMT_B3A8 && s->planeCount == 2)
+		return 1;
+	if (s->pixelFormat == SWEET_FMT_LA08 && s->planeCount <= 1 &&
+	    s->bytesPerElement == 2)
+		return 2;
+	return 3; /* recognized combo non-BGRA, but no decompressor here yet */
+}
+
+bool
+sweet_surface_needs_convert(SweetSurface *s)
+{
+	return sweet_surface_convert_kind(s) != 0;
+}
