+/*
+ * ath12k WLAN combination: fuxiwlan=1 and fuxiwlanath=1 (the boot that also
+ * links fuxi_ath12k.o). On this chain the GPU scanout and its CPU oracle only
+ * carry an 8-bit BGRA single-plane layout; a 10-bit / two-plane surface (e.g.
+ * 'b3a8') cannot be presented or copied, which stalls frames and drops to the
+ * double CPU fallback. In that combination only, refuse such layouts at the
+ * kernel surface boundary so the client falls back to the BGRA surface the
+ * scanout can present. Without both args the pre-existing acceptance is kept:
+ * single fuxiwlan, single fuxiath, and the default control boot are unchanged.
+ */
+static int
+sweet_surface_bgra_only(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		int wlan = 0, ath = 0;
+		unsigned wlan_on = PE_parse_boot_argn("fuxiwlan", &wlan, sizeof(wlan)) && wlan > 0;
+		unsigned ath_on = PE_parse_boot_argn("fuxiwlanath", &ath, sizeof(ath)) && ath == 1;
+		cached = (wlan_on && ath_on) ? 1 : 0;
+	}
+	return cached;
+}
+
 /* Geometry from the creation properties (IOSurface.h keys). */
