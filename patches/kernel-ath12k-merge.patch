+/* The firmware files live on the root volume; before the first open, wait for
+ * it like the legacy diagnostic path does. One wait per boot; failure is
+ * reported with the budget in milliseconds so a slow mount is distinguished
+ * from a missing image. */
+static int
+wla_wait_root(void)
+{
+	if (wla_root_waited) { return 0; }
+	uint64_t deadline = wla_now_ms() + WLA_ROOT_WAIT_MS;
+	for (;;) {
+		vnode_t root = vfs_rootvnode();
+		if (root) {
+			vnode_put(root);
+			wla_root_waited = true;
+			return 0;
+		}
+		if (wla_now_ms() >= deadline) {
+			printf("FUXI ATH12K: root volume not mounted within %u ms; firmware fetch deferred\n",
+			    WLA_ROOT_WAIT_MS);
