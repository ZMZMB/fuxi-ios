+/* Open one absolute firmware path, getattr, allocate, read, close. On
+ * success returns 0 and hands out the block and size; every failure stage keeps the
+ * raw open errno, and the absolute path is printed with the line. Synthetic
+ * stages: -2 getattr/type/size, -3 allocation, -4 read residual. */
+static int
+wla_fw_open_at(const char *base, const char *file, const char *path,
+    void **memory, uint64_t *size, int *residual)
+{
+	vnode_t filev = NULL;
+	vfs_context_t context = vfs_context_kernel();
+	*memory = NULL;
+	*size = 0;
+	*residual = 0;
+	int error = vnode_open(path, FREAD | O_NOFOLLOW | O_NONBLOCK, 0, 0, &filev, context);
+	struct vnode_attr attributes;
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_data_size);
+	if (!error) {
+		error = vnode_getattr(filev, &attributes, context);
+		if (!error && (vnode_vtype(filev) != VREG ||
+		    !VATTR_IS_SUPPORTED(&attributes, va_data_size) ||
+		    !attributes.va_data_size || attributes.va_data_size > WL_FW_MAX)) { error = -2; }
+		*size = (uint64_t)attributes.va_data_size;
+	}
+	void *block = (!error ? wla_alloc((size_t)*size) : NULL);
+	if (!block) { error = error ? error : -3; }
+	if (!error) {
+		error = vn_rdwr(UIO_READ, filev, (caddr_t)block, (int)*size, 0,
+		    UIO_SYSSPACE, 0, vfs_context_ucred(context), residual, vfs_context_proc(context));
+		if (*residual) { error = -4; }
+	}
+	int close_error = filev ? vnode_close(filev, FREAD, context) : 0;
+	if (error) {
+		wla_free(block);
+		if (close_error) {
+			printf("FUXI ATH12K: firmware %s (%s) close failed path %s errno %d\n",
+			    base, file, path, close_error);
+		}
+		printf("FUXI ATH12K: firmware %s (%s) path %s unavailable stage %d errno %d "
+		    "residual %d size %llu\n", base, file, path, error,
+		    error > 0 ? error : 0, *residual, *size);
+		return -1;
+	}
+	*memory = block;
+	return 0;
