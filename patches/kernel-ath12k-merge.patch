+	uint32_t class_code = (classrev >> 16) & 0xffffu;
+	printf("FUXI ATH12K: PCIe enum config window PA %#llx; BDF %u:%u.%u id %#x vendor %#x "
+	    "device %#x class %#x header %#x candidates 1\n",
