+			for (unsigned b = 0; b < len && b < 4; b++) { word |= (uint32_t)bytes[b] << (8 * b); }
+			printf("FUXI ATH12K: ADT   %s/%s len %u first %#x\n",
+			    nodes[ni], props[pi], len, word);
+		}
+	}
