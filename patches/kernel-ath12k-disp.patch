+	vnode_t dir = NULL;
+	int open_err = vnode_open(path, FREAD | O_NOFOLLOW | O_NONBLOCK, 0, 0, &dir, context);
+	int attr_err = 0;
+	uint64_t dir_size = 0;
+	if (!open_err) {
+		struct vnode_attr attributes;
+		VATTR_INIT(&attributes);
+		VATTR_WANTED(&attributes, va_data_size);
+		attr_err = vnode_getattr(dir, &attributes, context);
+		if (!attr_err) { dir_size = (uint64_t)attributes.va_data_size; }
