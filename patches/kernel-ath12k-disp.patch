+	    "/chosen", "/pcie0", "/pcie", "/soc/pcie0", "/soc/pcie", "/wifi0"
+	};
+	static const char *props[] = {
+	    "compatible", "status", "ranges", "reg", "iommu",
+	    "dma-coherent", "msi-parent", "mac-address-wifi0"
+	};
