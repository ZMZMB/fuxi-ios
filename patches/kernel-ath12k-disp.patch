+		for (unsigned pi = 0; pi < sizeof(props) / sizeof(props[0]); pi++) {
+			const void *val = NULL;
+			unsigned len = 0;
+			int pr = SecureDTGetProperty(node, props[pi], &val, &len);
+			if (pr != kSuccess || val == NULL || len == 0) {
+				printf("FUXI ATH12K: ADT   %s/%s absent\n", nodes[ni], props[pi]);
+				continue;
