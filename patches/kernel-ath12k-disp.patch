+/* v15fwdiag: one-shot path/root-volume decomposition, printed only after the
+ * retried firmware open still fails. Each successful vnode_lookup holds an
+ * iocount that is released with vnode_put; read-only, no state change. */
+static const char *
+wl_fwdiag_vtype(int t)
+{
+	switch (t) {
+	case VNON: return "VNON";
+	case VREG: return "VREG";
+	case VDIR: return "VDIR";
+	case VBLK: return "VBLK";
+	case VCHR: return "VCHR";
+	case VLNK: return "VLNK";
+	case VSOCK: return "VSOCK";
+	case VFIFO: return "VFIFO";
+	case VBAD: return "VBAD";
+	default: return "?";
+	}
+}
+
+static void
+wl_fw_open_diag(const char *path, vfs_context_t ctx)
+{
+	static const char *levels[] = {
+	    "/usr", "/usr/local", "/usr/local/share",
+	    "/usr/local/share/fuxi", "/usr/local/share/fuxi/wlan",
+	};
+	for (unsigned i = 0; i <= 5; i++) {
+		const char *p = (i < 5) ? levels[i] : path;
+		vnode_t lp = NULL;
+		int le = vnode_lookup(p, 0, &lp, ctx);
+		if (le) {
+			printf("FUXI WLAN DIAG: path %s lookup errno %d\n", p, le);
+			continue;
+		}
+		printf("FUXI WLAN DIAG: path %s lookup ok vtype %d (%s)\n",
+		    p, (int)vnode_vtype(lp), wl_fwdiag_vtype((int)vnode_vtype(lp)));
+		vnode_put(lp);
+	}
+	vnode_t rvp = vfs_rootvnode();
+	if (!rvp) {
+		printf("FUXI WLAN DIAG: root vnode unavailable for statfs\n");
+		return;
+	}
+	struct vfsstatfs *sf = vnode_vfsstatfs(rvp);
+	if (!sf) {
+		printf("FUXI WLAN DIAG: root statfs unavailable\n");
+	} else {
+		printf("FUXI WLAN DIAG: root volume fstype '%s' mntfrom '%s'\n",
+		    sf->f_fstypename, sf->f_mntfromname);
+	}
+	vnode_put(rvp);
+}
+
 static int
 wl_read_firmware(void)
 {
@@ -2923,9 +2978,22 @@
 	}
 	if (!root) { return 1; }
 	vnode_put(root);
-	int e = vnode_open(wl_fw_path, FREAD | O_NOFOLLOW | O_NONBLOCK, 0, 0, &vp, ctx);
+	/* Retry the open for up to 120 s (1200 x 100 ms); the root mount/name
+	 * space can still be settling at this early boot step. Each wait yields
+	 * this dedicated WLAN thread only; the main/launchd thread is not blocked.
+	 * On final failure the one-shot path/volume diagnostic runs once. */
+	int e = 0;
+	unsigned attempts = 0;
+	for (unsigned i = 0; i <= 1; i++) {
+		e = vnode_open(wl_fw_path, FREAD | O_NOFOLLOW | O_NONBLOCK, 0, 0, &vp, ctx);
+		attempts = i + 1;
+		if (!e) { break; }
+		if (i < 1200) { wl_sleep(100); }
+	}
 	if (e) {
-		printf("FUXI WLAN: firmware open failed errno %d\n", e);
+		printf("FUXI WLAN DIAG: firmware open failed (diag, no retry) "
+		    "attempts %u; last errno %d\n", attempts, e);
+		wl_fw_open_diag(wl_fw_path, ctx);
 		return 2;
 	}
